{
  "name": "daftar-desktop",
  "productName": "Daftar",
  "version": "1.1.0",
  "description": "Daftar notes for desktop",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.daftar.desktop",
    "productName": "Daftar",
    "files": ["main.js", "preload.js", "icon.png", "app/**/*"],
    "directories": { "output": "release" },
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "shortcutName": "Daftar" },
    "mac": { "target": "dmg", "category": "public.app-category.productivity" },
    "linux": { "target": "AppImage", "category": "Office" }
  }
}
